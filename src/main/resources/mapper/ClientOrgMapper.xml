<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.softpuzzle.pm.account.ClientOrgMapper">

    <select id="findById" resultType="ClientOrg">
        SELECT id, name, created_at FROM client_org WHERE id = #{id}
    </select>

    <select id="findByName" resultType="ClientOrg">
        SELECT id, name, created_at FROM client_org WHERE name = #{name}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO client_org (name) VALUES (#{name})
    </insert>

</mapper>
